---
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import ReviewStrip from "./ReviewStrip.astro";
import Motion from "./Motion.astro";
import "../styles/homepage.css";
import DoctorsSection from "./DoctorsSection.astro";
import CareSection from "./CareSection.astro";
import MembershipBand from "./MembershipBand.astro";
import TransformSection from "./TransformSection.astro";
import TechnologySection from "./TechnologySection.astro";
import ServicesDirectory from "./ServicesDirectory.astro";
import ExpertiseGrid from "./ExpertiseGrid.astro";
import ComfortSection from "./ComfortSection.astro";
import ReviewsBand from "./ReviewsBand.astro";
import ContactCta from "./ContactCta.astro";
import FaqSection from "./FaqSection.astro";
import OfficeSection from "./OfficeSection.astro";
import TrustBadges from "./TrustBadges.astro";
import Footer from "./Footer.astro";
import { reviewNeeds } from "../lib/homepage";
import { patientReviews } from "../lib/reviews";
interface Props { reviewMode?: boolean }
const { reviewMode = false } = Astro.props;
---
<Header />
<main id="main" tabindex="-1" class="homepage">
  <Hero />
  <ReviewStrip />
  <DoctorsSection />
  <ExpertiseGrid />
  <CareSection />
  <TransformSection />
  <MembershipBand />
  <TechnologySection />
  <ServicesDirectory />
  <ReviewsBand reviews={patientReviews} reviewMode={reviewMode} />
  <ComfortSection />
  <FaqSection />
  <OfficeSection reviewMode={reviewMode} />
  <TrustBadges reviewMode={reviewMode} />
  <ContactCta />
</main>
<Footer reviewMode={reviewMode} />
<Motion />
{reviewMode && <><a class="review-dock" href="#review-checklist">November design review · {reviewNeeds.length} Follow-Ups ↓</a><section class="review-checklist section-space" id="review-checklist" aria-labelledby="review-title"><div class="shell"><p class="review-kicker">Local review · William’s November brief</p><h2 id="review-title">Homepage and shared styling</h2><p class="review-intro">William’s charcoal palette, brand typefaces, Pair photos, Cards technology and Tiles treatments are implemented for local review. Existing interior copy and integrations are preserved. The later page package and publication await review. Google review totals are omitted until aggregate data is available; the lab photo is the supplied stand-in for a clearer 3D printer photo.</p><p><a class="text-link" href="/migration-review/">Review The Interior Pages</a></p><div class="review-request-grid">{reviewNeeds.map(item => <article><h3><a href={"#" + item.section}>{item.title} ↗</a></h3><p>{item.detail}</p></article>)}</div><a class="button button-outline" href="/">View Without Review Notes</a></div></section></>}
