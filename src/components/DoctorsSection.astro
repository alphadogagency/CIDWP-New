---
import { Image } from "astro:assets";
import { photos } from "../lib/homepage";
import { site } from "../lib/site";
import Icon from "./Icon.astro";
---
<section class="doctors-section section-space" id="doctors" aria-labelledby="doctors-title" data-section="doctors">
  <div class="shell doctors-grid">
    <div class="doctor-portraits">
      <figure><Image src={photos.osiiFrontDesk} alt="The Oral Surgery and Implant Institute front desk" widths={[400, 650, 900]} sizes="(min-width: 900px) 22vw, 44vw" loading="lazy" style={{ objectPosition: "80% center" }} /><figcaption><strong>Oral Surgery & Implant Institute</strong></figcaption></figure>
      <figure><Image src={photos.cidwpFrontDesk} alt="The Cosmetic & Implant Dentistry Westport front desk" widths={[450, 750, 900]} sizes="(min-width: 900px) 22vw, 44vw" loading="lazy" /><figcaption><strong>Cosmetic & Implant Dentistry Westport</strong></figcaption></figure>
    </div>
    <div class="section-copy"><h2 id="doctors-title"><span class="text-brand">Get To Know</span><br />Your Dental Team.</h2><p>Dr. Hunter McAreavy and our Westport team take the time to hear what matters to you. Whether you’re visiting for a checkup or considering a change to your smile, you’ll have people to talk it through with.</p><a href={site.doctorsUrl} class="button button-outline">Meet Us <Icon /></a></div>
  </div>
</section>
