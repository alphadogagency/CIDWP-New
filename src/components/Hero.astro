---
import { Image } from "astro:assets";
import clinical from "../assets/round2/clinical-care.jpg";
import ActionPair from "./ActionPair.astro";
---
<section class="hero" aria-labelledby="hero-title" data-section="hero">
  <div class="hero-media"><Image src={clinical} alt="A member of our Westport dental team caring for a patient" widths={[600, 900, 1200]} sizes="(min-width: 901px) 66vw, 100vw" loading="eager" fetchpriority="high" /></div>
  <div class="hero-shade"></div>
  <div class="shell hero-content"><div class="hero-copy">
    <p class="hero-location eyebrow">Your dentist in Westport, Kansas City</p>
    <h1 id="hero-title">Feel at home<br /><em>in our care.</em></h1>
    <p class="hero-description">Everyday dentistry. A familiar team. Time to get to know you.</p>
    <ActionPair light />
  </div></div>
</section>
