---
import type { PageContent } from '../lib/page-package';
import { packageData, practiceLinks, videoWatchUrl } from '../lib/page-package';
import { practicePeople, peopleByKey } from '../lib/team';
import { patientReviews } from '../lib/reviews';
import { site } from '../lib/site';
import PageOverview from './PageOverview.astro';
import PagePhoto from './PagePhoto.astro';
import PersonPortrait from './PersonPortrait.astro';
import PageFaq from './PageFaq.astro';
import PageRelated from './PageRelated.astro';
import ReviewsBand from './ReviewsBand.astro';
import NewPatientBand from './NewPatientBand.astro';
import InquiryForm from './InquiryForm.astro';
interface Props { page: PageContent }
const { page } = Astro.props;
const mapUrl = 'https://www.google.com/maps?q=' + encodeURIComponent(site.address + ', ' + site.city) + '&output=embed';
const office = [['The welcoming lobby at our Westport location', 'Our lobby'], ['Large windows and natural light in a Westport treatment room', 'Treatment rooms'], ['The front desk at our Westport location', 'Front desk'], ['CBCT imaging equipment at the Westport practice', '3D CBCT imaging'], ['Parking at our Westport location', 'Private parking']];
const values = [['Time to talk', 'We listen to your concerns and explain your options before treatment begins.'], ['Technology that helps', 'Digital X-rays, intraoral cameras and 3D imaging help us look more closely at your dental health.'], ['Comfort at every turn', 'Free Wi-Fi, coffee, tea and bottled water while you wait, and sedation on select days.'], ['One roof', 'Checkups, cosmetic work, implants and oral surgery, all at 638 W 39th St.']];
const visits = [['Parking at our Westport location', 'Park at the office', 'Our private parking lot is right at the office.'], ['The front desk at our Westport location', 'Check in at the front desk', 'Our patient care coordinators will get you settled and answer questions.'], ['The welcoming lobby at our Westport location', 'Relax before your visit', 'Free Wi-Fi, coffee, tea and bottled water while you wait.']];
---
<PageOverview page={page} />
{page.kind === 'contact' && <section class="page-section" id="contact-form"><div class="shell"><InquiryForm /></div></section>}
{page.kind === 'about' && <><section class="page-section"><div class="shell"><p class="eyebrow">Our doctors</p><h2>Everyday care and surgery, under one roof.</h2><div class="doctor-cards">{packageData.doctors.map(doctor => <a href={doctor.k === 'baker' ? '/sedation/' : `${site.doctorsUrl}#dr-${doctor.k}`}><PersonPortrait person={peopleByKey[doctor.k]} /><p class="eyebrow">{doctor.role}</p><h3>{peopleByKey[doctor.k].name}</h3><p>{doctor.short}</p><span>Meet {doctor.k === 'hunter' ? 'Dr. Hunter' : doctor.k === 'owen' ? 'Dr. Lonergan' : doctor.k === 'patrick' ? 'Dr. Lucaci' : 'Dr. Baker'} →</span></a>)}</div><a class="text-link" href={site.teamUrl}>Meet the whole team →</a></div></section><section class="page-section"><div class="shell"><p class="eyebrow">What to expect</p><h2>Care built around you.</h2><div class="practice-values page-swipe" tabindex="0" aria-label="What to expect; scroll to explore">{values.map(([title, description]) => <article><h3>{title}</h3><p>{description}</p></article>)}</div></div></section><section class="page-section"><div class="shell"><p class="eyebrow">Our office</p><h2>Make yourself comfortable.</h2><div class="office-mosaic">{office.map(([alt, label]) => <figure><PagePhoto alt={alt} /><figcaption>{label}</figcaption></figure>)}</div></div></section></>}
{page.kind === 'contact' && <><section class="page-section"><div class="shell contact-block"><div class="contact-info"><div><p class="eyebrow">Call</p><a class="contact-number" href={site.phoneUrl}>{site.phone}</a></div><div><p class="eyebrow">Visit</p><address>{site.address}<br />{site.city}</address><a class="text-link" href={site.directionsUrl}>Get directions →</a></div><div><p class="eyebrow">Hours</p><p>{site.hours}</p><p class="small-copy">Please call for appointment availability.</p></div><div><p class="eyebrow">Parking</p><p>Private parking on site</p></div></div><div class="contact-map"><iframe src={mapUrl} title="Map to Cosmetic & Implant Dentistry Westport" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade" /><a class="text-link" href={site.directionsUrl}>Open in Google Maps →</a></div></div></section><section class="page-section"><div class="shell"><p class="eyebrow">Plan your visit</p><h2>Easy to find, easy to park.</h2><div class="visit-cards page-swipe" tabindex="0" aria-label="Plan your visit; scroll to explore">{visits.map(([alt, title, description]) => <article><PagePhoto alt={alt} /><h3>{title}</h3><p>{description}</p></article>)}</div></div></section><section class="page-section"><div class="shell"><p class="eyebrow">Before you call</p><h2>Find what you need.</h2><div class="contact-links">{[['New patient special', '/about/specials/', 'Your first exam, X-rays and cleaning for $99.'], ['Emergency care', '/services/emergency-dentist/', 'Call for the soonest available visit.'], ['Smile Club', '/smile-club/', 'Membership plans with preventive care included.'], ['Payment plans', '/payment-plans/', 'Explore ways to pay for your treatment.']].map(([title, href, description]) => <a href={href}><h3>{title}</h3><p>{description}</p><span>Learn more →</span></a>)}</div></div></section></>}
{page.kind === 'docs' && packageData.doctors.map((doctor, i) => <section class="page-section doctor-profile" id={`dr-${doctor.k}`}><div class:list={['shell doctor-profile-grid', { 'profile-reverse': i % 2 !== 0 }]}><div class:list={['doctor-profile-photo', { 'page-feature-photo': i === 0 }]}><PersonPortrait person={peopleByKey[doctor.k]} sizes="(min-width: 900px) 35vw, 92vw" />{doctor.video && <a class="text-link" href={videoWatchUrl}>Watch Dr. Lucaci →</a>}</div><div><p class="eyebrow">{doctor.role}</p><h2>{doctor.full}</h2><p>{doctor.bio}</p><dl class="doctor-credentials">{doctor.creds.map(([label, detail]) => <div><dt>{label}</dt><dd>{detail}</dd></div>)}</dl><div class="page-chips">{doctor.treats.map(([label, href]) => <a href={href}>{label} →</a>)}</div><a class="button button-brand" href={doctor.cta[1] || site.bookingUrl}>{doctor.cta[0]} →</a></div></div></section>)}
{page.kind === 'team' && <section class="page-section"><div class="shell" data-team-filter><p class="eyebrow">Your Westport team</p><h2>Come meet us.</h2><div class="team-filters" role="group" aria-label="Filter team members">{[['all', 'Everyone'], ['front', 'Front desk'], ['chairside', 'Hygiene & chairside'], ['surgery', 'Oral surgery'], ['doctors', 'Doctors']].map(([value, label]) => <button type="button" data-filter={value} aria-pressed={value === 'all'}>{label}</button>)}</div><p class="sr-only" aria-live="polite" data-team-count>Showing all 9 team members.</p><div class="all-team-grid">{practicePeople.map(person => <article data-team-group={person.group} data-team-doctor={person.doctor}><PersonPortrait person={person} /><h3>{person.doctor ? <a href={`${site.doctorsUrl}#dr-${person.key}`}>{person.name}</a> : person.name}</h3><p>{person.role}</p></article>)}<a class="team-visit-tile" data-team-group="all" href={site.bookingUrl}><p class="eyebrow">Your smile next</p><h3>Come meet us.</h3><span>Book a visit →</span></a></div></div></section>}
{['about', 'docs'].includes(page.kind) && <ReviewsBand reviews={patientReviews.slice(0, 3)} />}
{page.kind !== 'contact' && <><NewPatientBand /><PageFaq questions={page.faq || []} name={page.name} /><PageRelated links={practiceLinks} practice /></>}
<script>
  document.querySelectorAll<HTMLElement>('[data-team-filter]').forEach(root => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-team-group]')];
    buttons.forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
      let count = 0;
      items.forEach(item => {
        const matches = filter === 'all' || item.dataset.teamGroup === filter || (filter === 'doctors' && item.dataset.teamDoctor === 'true');
        item.hidden = !matches;
        if (matches && item.dataset.teamGroup !== 'all') count++;
      });
      const status = root.querySelector('[data-team-count]');
      if (status) status.textContent = `Showing ${count} team members.`;
    }));
  });
</script>
