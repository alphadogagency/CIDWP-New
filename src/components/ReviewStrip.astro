---
import Icon from "./Icon.astro";
---
<aside class="review-strip" aria-label="Patient reviews on Google">
  <a class="review-proof" href="#reviews" data-google-rating data-rating-compact>
    <img src="/google-wordmark.png" alt="Google" width="92" height="30" />
    <span><span class="proof-stars" aria-hidden="true">★★★★★</span><strong data-rating-label>Words from our patients</strong><small data-rating-fallback>Selected five-star reviews</small><small class="proof-attribution" translate="no">Maps</small></span>
    <span class="proof-link">Read reviews <Icon /></span>
  </a>
</aside>
<script>
  import { initializeGoogleRatings } from '../scripts/google-reviews-client';
  initializeGoogleRatings();
</script>
