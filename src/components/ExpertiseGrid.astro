---
import { Image } from "astro:assets";
import { expertise } from "../lib/homepage";
import Icon from "./Icon.astro";
---
<section class="expertise-section section-space" id="expertise" aria-labelledby="expertise-title" data-section="expertise"><div class="shell">
  <p class="eyebrow">Treatments</p><h2 class="section-heading" id="expertise-title">Find the care<br />you’re looking for.</h2>
  <div class="expertise-grid">{expertise.map(service => <a class="expertise-tile" href={service.href}><Image src={service.image} alt="" widths={[400, 700, 1000]} sizes="(max-width: 700px) 45vw, 30vw" loading="lazy" class="expertise-photo" style={{ objectPosition: service.position }} /><span class="expertise-label">{service.label}<Icon /></span></a>)}</div>
</div></section>
