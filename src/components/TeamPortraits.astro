---
import { Image } from "astro:assets";
import type { TeamMember } from "../lib/team";
import Icon from "./Icon.astro";
interface Props { people: TeamMember[]; interior?: boolean }
const { people, interior = false } = Astro.props;
---
<div class:list={["team-portraits", { "team-portraits-interior": interior }]}>
  {people.map(person => <figure>
    <Image src={person.image} alt={person.name + ", " + person.role} widths={[300, 500, 750]} sizes={interior && people.length === 2 ? "(min-width: 900px) 28vw, 44vw" : "(min-width: 900px) 23vw, 44vw"} loading="lazy" style={{ objectPosition: person.position || "50% 35%" }} />
    <figcaption>
      <strong>{person.name}</strong>
      <span>{person.role}</span>
      {person.href && <a class="provider-link" href={person.href} aria-label={"View Provider Profile For " + person.name}>View Provider Profile <Icon /></a>}
    </figcaption>
  </figure>)}
</div>
