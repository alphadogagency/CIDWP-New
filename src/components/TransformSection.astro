---
import { Image } from "astro:assets";
import { photos } from "../lib/homepage";
import { serviceLinks } from "../lib/site";
import Icon from "./Icon.astro";

---
<section class="implant-section section-space" id="implants" aria-labelledby="implant-title" data-section="implants">
  <div class="shell split-layout"><div class="feature-photo photo-block" data-reveal><Image src={photos.smile} alt="A woman smiling at our Westport practice" widths={[650, 1000, 1400]} sizes="(min-width: 901px) 45vw, 90vw" loading="lazy" /><figure class="implant-detail"><Image src={photos.implantDenture} alt="An implant-supported denture" widths={[200, 400]} sizes="140px" loading="lazy" /><figcaption>Explore your options</figcaption></figure></div><div class="section-copy" data-reveal><p class="eyebrow">Dental implants</p><h2 id="implant-title">Let’s talk about<br />your smile.</h2><p>If missing teeth are affecting how you eat or smile, we can help you explore your options. Dental implants and restorative care can be part of a plan shaped around your needs.</p><p>Start with a conversation about your concerns, your goals, and what the next step could look like.</p><a class="text-link" href={serviceLinks.implants}>Explore dental implants <Icon /></a></div></div>
</section>
