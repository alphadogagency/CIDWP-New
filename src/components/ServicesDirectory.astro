---
import { Image } from "astro:assets";
import { services } from "../lib/homepage";
import { serviceLinks } from "../lib/site";
import Icon from "./Icon.astro";
const chips = [
  [["General dentistry", serviceLinks.general], ["Sedation options", serviceLinks.sedation], ["Emergency dentistry", serviceLinks.emergency]],
  [["Dental implants", serviceLinks.implants], ["Crowns & bridges", serviceLinks.crowns], ["Full-mouth restoration", serviceLinks.restoration]],
  [["Veneers", serviceLinks.veneers], ["Teeth whitening", serviceLinks.whitening], ["Clear braces", serviceLinks.clearBraces]],
];
---
<section class="services-section section-space" id="services" aria-labelledby="services-title" data-section="services"><div class="shell">
  <p class="eyebrow">Our care</p><h2 class="section-heading" id="services-title">Let’s care for your smile.</h2>
  <div class="service-tiles">{services.map((service, index) => <article class:list={["service-tile", { "service-tile-reverse": index % 2 === 1 }]} id={service.id} data-reveal><div class="service-photo"><Image src={service.image} alt={service.alt} widths={[650, 1000, 1400]} sizes="(min-width: 901px) 45vw, 90vw" loading="lazy" /></div><div class="service-copy"><p class="service-label">{service.label}</p><h3>{service.title}</h3><p>{service.description}</p><div class="treatment-chips">{chips[index].map(([label,href]) => <a href={href}>{label}</a>)}</div><a href={service.href} class="text-link">{service.cta} <Icon /></a></div></article>)}</div>
</div></section>
