---
import "../styles/global.css";
import { site } from "../lib/site";
import socialImage from "../assets/round2/clinical-care.jpg";
import pageData from '../data/november-pages.json';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  robots?: string;
}

const { title = site.title, description = site.description, noindex = false, robots = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const socialImageUrl = new URL(socialImage.src, site.url).href;
const practiceSchema = { '@context': 'https://schema.org', '@type': 'Dentist', '@id': site.url + '#practice', name: site.name, url: site.url, telephone: site.phone, hasMap: site.directionsUrl, address: { '@type': 'PostalAddress', streetAddress: site.address, addressLocality: 'Kansas City', addressRegion: 'MO', postalCode: '64111', addressCountry: 'US' }, ...(Astro.url.pathname === '/about/' ? { employee: pageData.doctors.map(doctor => ({ '@type': 'Person', '@id': site.url + 'about/meet-the-doctors/#dr-' + doctor.k, name: doctor.full, jobTitle: doctor.role })) } : {}) };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(practiceSchema)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {(noindex || robots) && <meta name="robots" content={noindex ? 'noindex, nofollow' : robots} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Patient care at Cosmetic & Implant Dentistry Westport" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a
      href="#main"
      class="skip-link"
      >Skip to main content</a
    >
    <slot />
  </body>
</html>
